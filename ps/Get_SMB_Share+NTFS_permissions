$TargetShares = @(
    "Finanzen",
    "Geschaeftsleitung",
    "Mitarbeiter"
)

$shares = Get-SmbShare | Where-Object { $TargetShares -contains $_.Name }

$result = foreach ($s in $shares) {

    # --- SHARE PERMISSIONS ---
    $sharePermsList = Get-SmbShareAccess -Name $s.Name | ForEach-Object {
        "$($_.AccountName) ($($_.AccessRight))"
    }
    $sharePerms = $sharePermsList -join "; "

    # --- NTFS PERMISSIONS ---
    if ($s.Path -and (Test-Path $s.Path)) {

        $ntfsPermsList = (Get-Acl $s.Path).Access | ForEach-Object {
            "$($_.IdentityReference) ($($_.FileSystemRights))"
        }

        $ntfsPerms = $ntfsPermsList -join "; "
    }
    else {
        $ntfsPerms = "Path not found"
    }

    [PSCustomObject]@{
        ShareName      = $s.Name
        Path           = $s.Path
        ShareAccounts  = $sharePerms
        NTFSAccounts   = $ntfsPerms
    }
}

$result | Export-Csv "C:\Reports\DataShares_Permissions.csv" -Encoding UTF8 -NoTypeInformation

Write-Host "CSV created: C:\Reports\DataShares_Permissions.csv" -ForegroundColor Green
