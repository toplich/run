Важливий нюанс щодо фільтра: якщо фільтрувати строго за 22D2025-11, файл метаданих Yetiweb_hzcc_79CE1.vbm не потрапить у копію (у його імені немає дати) — а без .vbm Veeam не зможе розпізнати ланцюжок при Import Backup. Тому я додав окреме правило, яке завжди включає всі .vbm-файли незалежно від дати (вони маленькі, це не вплине на обсяг).

1. Скрипт (виконати на veeam-repo — сервері-джерелі):

bash
cat << 'EOF' > /root/sync-nov-yetiweb.sh
#!/bin/bash
set -u

SRC="/mnt/veeam/STEP k44 Backup/STEP CCHZ"
DEST_HOST="root@138.201.252.215"
DEST_PATH="/mnt/backup-disk/veeam"
LOGFILE="/var/log/sync-nov-yetiweb.log"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOGFILE"
}

log "=== Старт синхронізації: 22D2025-11 (Yetiweb_hzcc, листопад) ==="

while true; do
  log "Спроба з'єднання і копіювання..."

  rsync -avh --partial --progress --append-verify \
    --include='*/' \
    --include='*22D2025-11*' \
    --include='*.vbm' \
    --exclude='*' \
    -e "ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10" \
    "$SRC/" "$DEST_HOST:$DEST_PATH/" 2>&1 | tee -a "$LOGFILE"

  RC=${PIPESTATUS[0]}

  if [ "$RC" -eq 0 ]; then
    log "Копіювання завершено успішно."
    break
  else
    log "Помилка/розрив з'єднання (код $RC). Повтор через 30 секунд."
    sleep 30
  fi
done

log "=== Задача завершена ==="
EOF
chmod +x /root/sync-nov-yetiweb.sh

