Скрипт з періодом дат
bash
cat << 'EOF' > /root/vsync.sh
#!/bin/bash
set -u

SRC="/mnt/veeam/STEP k44 Backup"
DEST_HOST="root@138.201.252.215"
DEST_PATH="/mnt/backup-disk/veeam"
LOGFILE="/var/log/vsync.log"
FILELIST="/tmp/vsync-filelist.txt"

# Період копіювання (включно з обома датами)
DATE_FROM="2025-11-07"
DATE_TO="2025-11-08"

log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOGFILE"
}

# Верхня межа - "наступний день після DATE_TO", щоб включити весь DATE_TO цілком
DATE_TO_EXCL=$(date -d "$DATE_TO +1 day" +%Y-%m-%d)

log "=== Старт синхронізації: період $DATE_FROM - $DATE_TO ==="

# Формуємо список файлів: усе в межах періоду + всі .vbm (метадані) окремо
find "$SRC" -type f -newermt "$DATE_FROM 00:00:00" ! -newermt "$DATE_TO_EXCL 00:00:00" -printf '%P\n' > "$FILELIST"
find "$SRC" -type f -iname '*.vbm' -printf '%P\n' >> "$FILELIST"
sort -u "$FILELIST" -o "$FILELIST"

log "Знайдено файлів для копіювання: $(wc -l < "$FILELIST")"

while true; do
  log "Спроба з'єднання і копіювання..."

  rsync -avh --partial --progress --append-verify \
    --files-from="$FILELIST" \
    -e "ssh -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o ConnectTimeout=10" \
    "$SRC/" "$DEST_HOST:$DEST_PATH/" 2>&1 | tee -a "$LOGFILE"

  RC=${PIPESTATUS[0]}

  if [ "$RC" -eq 0 ]; then
    log "Копіювання завершено успішно."
    break
  else
    log "Помилка/розрив з'єднання (код $RC). Повтор через 30 секунд."
    sleep 30
  fi
done

log "=== Задача завершена ==="
EOF
chmod +x /root/vsync.sh

